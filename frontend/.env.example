# Base URL for the Smart Apply API.
#
# In local development, leave this unset — Vite's dev server proxies /api
# to http://127.0.0.1:8000 (see vite.config.ts), and the app defaults to
# '/api' when this variable isn't provided.
#
# In production, point this at your deployed backend, e.g.:
# VITE_API_BASE_URL=https://api.your-domain.com/api
VITE_API_BASE_URL=/api
