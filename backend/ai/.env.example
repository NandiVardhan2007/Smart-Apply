# AI Engine Microservice Environment Variables (.env.example)
ENVIRONMENT=production
PORT=8001
SECRET_KEY=your_shared_jwt_secret_key_here

MONGODB_DB_NAME=smartapply
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/smartapply
REDIS_URL=redis://user:pass@redis-host:6379

NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_IMAGE=nvapi-your-nvidia-image-api-key
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

CHATBOT_API_KEY=nvapi-your-chatbot-nvidia-api-key
INTERVIEW_EVAL_API_KEY=nvapi-your-interview-eval-key
PROJECT_FINDER_API_KEY=nvapi-your-project-finder-key

GROQ_API_KEY=gsk_your_groq_api_key

BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=your-email@domain.com
BREVO_SENDER_NAME=SmartApply

LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-livekit-domain.cloud

EXTERNAL_URL=https://smartapply-ai.onrender.com
FRONTEND_URL=https://smartapply.onrender.com
