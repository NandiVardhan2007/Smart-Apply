# Core API Microservice Environment Variables (.env.example)
ENVIRONMENT=production
PORT=8000
SECRET_KEY=your_shared_jwt_secret_key_here

MONGODB_DB_NAME=smartapply
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/smartapply
REDIS_URL=redis://user:pass@redis-host:6379

BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=your-email@domain.com
BREVO_SENDER_NAME=SmartApply

RAPIDAPI_KEY=your-rapidapi-key

R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_ACCOUNT_ID=your-cloudflare-r2-account-id
R2_BUCKET_NAME=smartapply
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key

EXTERNAL_URL=https://smartapply-core.onrender.com
FRONTEND_URL=https://smartapply.onrender.com
