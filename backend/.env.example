# ── JWT ──
SECRET_KEY=your-super-secret-key-change-this
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=smartapply

# ── Brevo (Email OTP) ──
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Smart Apply

# ── NVIDIA NIM (AI) ──
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
NVIDIA_IMAGE=
NVIDIA_IMAGE_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

CHATBOT_API_KEY=
PROJECT_FINDER_API_KEY=
INTERVIEW_EVAL_API_KEY=

# ── Cloudflare R2 (Storage) ──
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=smartapply-uploads
R2_PUBLIC_URL=https://your-r2-public-url.com

# ── Groq (Voice Interview) ──
GROQ_API_KEY=your-groq-api-key

# ── App URLs ──
FRONTEND_URL=https://smartapplies.app
EXTERNAL_URL=
